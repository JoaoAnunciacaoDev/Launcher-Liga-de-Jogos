{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Liga de Jogos UEFS",
  "version": "0.1.2",
  "identifier": "br.edu.uefs.ligadejogos.launcher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Liga de Jogos UEFS",
        "width": 1280,
        "height": 720,
        "minWidth": 960,
        "minHeight": 600,
        "fullscreen": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
